---
import { config_site } from '../utils/config-adapter'

const currentYear = new Date().getFullYear();
---
<link href="https://fonts.googleapis.com/css2?family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&family=Pixelify+Sans:wght@400..700&display=swap" rel="stylesheet">

<footer class="site-footer">
    <div class="footer-bottom-text">
   <span class="copyrightFooter"><span class="copyright-simbol">©</span> {currentYear}</span> 
   Keep calm and analyze the logs.
   <br>
   Powered by <a href="https://github.com/xingwangzhe/stalux" target="_blank">Stalux</a> theme.
</div>
</footer>

<!-- Footer Style -->

<style>

.site-footer {
  width: 100%;
  padding: 14px 0;
  text-align: center;
  margin-top: auto;
  font-size: 0.9rem;
  color: rgb(255, 255, 255);
  background-color: rgba(0, 0, 0, 0.18); 
  margin-top: 30px;
  font-family: 'Pixelify Sans';
}

.copyright-simbol {
  font-family: 'sans';
}

.copyrightFooter {
  font-family: 'Pixelify Sans';
}

.footer-content {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1rem; 
}

.footer-bottom-text {
  display: block;
  font-size: 14px;
  color: #f0f0f0;
  text-align: center;
}

.footer-bottom-text a {
  color: inherit;
  text-decoration: none;
  font-family: 'Pixelify Sans';
}

.footer-bottom-text a:hover {
  text-decoration: underline;
}

@media (max-width: 768px) {
  .site-footer {
    padding: .5rem 0;
    font-size: 0.8rem;
  }

  .footer-content {
    gap: 0.6rem;
    padding: 0 0.8rem;
  }
}
</style>
